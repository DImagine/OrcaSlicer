{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orcaslicer:ai-seams:response:1",
  "title": "OrcaSlicer AI seam response v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "export_id",
    "export_digest",
    "seams"
  ],
  "properties": {
    "format": {
      "const": "orca-ai-seams-response"
    },
    "version": {
      "const": 1
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "export_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "object_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "occurrence_id",
          "x_mm",
          "y_mm",
          "edge"
        ],
        "properties": {
          "occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "x_mm": {
            "type": "number"
          },
          "y_mm": {
            "type": "number"
          },
          "edge": {
            "description": "XY (without Z) of two consecutive points of the same request path, in path order, naming the segment that holds the seam. Swapped ends are accepted; a point on its loop but off this segment is placed at the nearest loop point with a warning (rejected in strict mode).",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "exception": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "playbook": {
      "$ref": "#/$defs/playbook"
    },
    "plate": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$comment": "Additionally require unique occurrence IDs, finite XY, the current geometry digest, full bijection and distance <= 0.05 mm from the exact source loop, in the same object_local millimeters as the request paths.",
  "$defs": {
    "playbook": {
      "type": "object",
      "required": [
        "format",
        "version",
        "text"
      ],
      "properties": {
        "format": {
          "const": "orca-ai-seams-playbook"
        },
        "version": {
          "const": 1
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
